# Facebook Graph API — needed to sync the news section (npm run sync-news)
# See README.md "Configurare Facebook" for how to obtain these.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Only needed once, to generate FB_PAGE_ACCESS_TOKEN with: npm run fb-token
# (you can delete them afterwards)
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
