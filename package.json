{
  "name": "rotary-club-caransebes",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run photos && npm run sync-news && astro check && astro build",
