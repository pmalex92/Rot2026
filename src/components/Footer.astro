---
import { getLangFromUrl, useTranslations, localePath } from '../i18n/utils';
import { nav } from '../data/navigation';
import RotaryWheel from './RotaryWheel.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const [emailUser, emailDomain] = site.email.split('@');
const heading = 'font-body text-sm font-bold uppercase tracking-wide text-rotary-gold';
---

<footer class="relative overflow-hidden bg-rotary-navy text-white">
  <RotaryWheel class="pointer-events-none absolute -top-16 -right-16 h-64 w-64 text-white/5 lg:h-96 lg:w-96" />

  <div class="container-page relative grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <img src="/images/logo-rotary-caransebes-light.png" alt="Rotary Club Caransebeș" class="h-10 w-auto" width="220" height="73" />
      <p class="mt-4 max-w-xs text-sm text-white/70">{t('footer.tagline')}</p>
      <div class="mt-5 flex gap-3">
        <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Facebook">
          <Icon name="facebook" class="h-5 w-5" />
        </a>
        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
          <Icon name="instagram" class="h-5 w-5" />
        </a>
      </div>
    </div>

    <div>
      <h3 class={heading}>{t('footer.nav')}</h3>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-white/80 sm:grid-cols-1">
        {
          nav.map((item) => (
            <li>
              <a href={localePath(lang, item.href)} class="hover:text-white">
                {t(item.key as any)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class={heading}>{t('footer.contact')}</h3>
      <ul class="mt-4 space-y-3 text-sm text-white/80">
        <li>
          <a href={`mailto:${site.email}`} class="[overflow-wrap:anywhere] hover:text-white">{emailUser}@<wbr />{emailDomain}</a>
        </li>
        <li>{site.address}</li>
        <li>
          <span class="block font-semibold text-white/90">{t('footer.meetings')}</span>
          {site.meeting[lang].when}
          <span class="block text-white/60">{site.meeting[lang].where}</span>
        </li>
      </ul>
    </div>

    <div>
      <h3 class={heading}>{t('footer.info')}</h3>
      <p class="mt-4 text-sm text-white/80">{t('footer.donateText')}</p>
      <dl class="mt-4 space-y-1 text-sm">
        <dt class="sr-only">{t('page.doneaza.beneficiary')}</dt>
        <dd class="font-semibold">{site.bank.beneficiary}</dd>
        <div class="flex gap-2">
          <dt class="text-white/60">CIF:</dt>
          <dd>{site.bank.cif}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-white/60">IBAN:</dt>
          <dd class="font-mono text-[13px] break-all">{site.bank.iban}</dd>
        </div>
        <dt class="sr-only">{t('page.doneaza.bankName')}</dt>
        <dd>{site.bank.bankName}</dd>
      </dl>
      <a href={localePath(lang, '/doneaza')} class="btn-primary mt-5 px-5 py-2 text-xs">{t('nav.doneaza')}</a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center justify-between gap-2 py-5 text-center text-xs text-white/50 sm:flex-row sm:text-left">
      <p>&copy;{site.founded} – {year} Rotary Club Caransebeș. {t('footer.rights')}</p>
      <p>Rotary International · {site.district[lang]}</p>
    </div>
  </div>
</footer>
