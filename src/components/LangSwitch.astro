---
import { getLangFromUrl, switchLocalePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const target = lang === 'ro' ? 'en' : 'ro';
const href = switchLocalePath(Astro.url, target);
---

<a
  href={href}
  class="inline-flex h-9 min-w-9 items-center justify-center rounded-full border border-white/30 px-3 text-xs font-bold uppercase tracking-wide text-white transition hover:bg-white/10"
  aria-label={target === 'en' ? 'Switch to English' : 'Comută pe română'}
>
  {target}
</a>
