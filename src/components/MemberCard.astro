---
interface Props {
  name: string;
  role?: string;
}
const { name, role } = Astro.props;

const initials = name
  .split(/[\s-]+/)
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toLocaleUpperCase('ro-RO');
---

<li class="card flex flex-col items-center gap-3 p-4 text-center sm:p-5" data-reveal>
  <span
    class="flex h-16 w-16 items-center justify-center rounded-full bg-rotary-blue font-display text-xl font-bold text-white ring-4 ring-rotary-gold/30 sm:h-20 sm:w-20 sm:text-2xl"
  >
    {initials}
  </span>
  <div>
    {role && <p class="mb-1 text-[11px] font-bold tracking-widest text-rotary-gold uppercase">{role}</p>}
    <p class="font-display leading-snug font-bold text-rotary-blue">{name}</p>
  </div>
</li>
