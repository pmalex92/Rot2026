---
import RotaryWheel from './RotaryWheel.astro';

interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}
const { title, intro, eyebrow } = Astro.props;
---

<section class="relative overflow-hidden bg-rotary-blue text-white">
  <RotaryWheel class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 text-white/10 sm:h-96 sm:w-96" />
  <div class="container-page relative py-12 sm:py-16">
    {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-3xl font-extrabold leading-tight text-white sm:text-4xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-white/80 sm:text-lg">{intro}</p>}
    <span class="mt-6 block h-1 w-16 rounded-full bg-rotary-gold"></span>
  </div>
</section>
