---
import { breadcrumbs, jsonLdScript, siteGraph, type JsonLd } from '../lib/seo';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Extra structured data for this page (Article, FAQPage, …). */
  jsonLd?: JsonLd[];
}
const { title, description, image = '/images/og-cover.jpg', imageAlt, type = 'website', noindex = false, jsonLd = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const isDefaultImage = image === '/images/og-cover.jpg';
const pageName = title.split(' — ')[0];

const trail = noindex ? undefined : breadcrumbs(Astro.url.pathname, lang, pageName);
const graph = [...siteGraph(lang), ...(trail ? [trail] : []), ...jsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalURL} />}

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt ?? pageName} />
<meta property="og:locale" content={isEn ? 'en_GB' : 'ro_RO'} />
<meta property="og:locale:alternate" content={isEn ? 'ro_RO' : 'en_GB'} />
<meta property="og:site_name" content="Rotary Club Caransebeș" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" set:html={jsonLdScript(graph)} />
