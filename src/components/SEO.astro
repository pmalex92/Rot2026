---
interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/images/og-cover.jpg' } = Astro.props;
const isEn = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content={isEn ? 'en_GB' : 'ro_RO'} />
<meta property="og:locale:alternate" content={isEn ? 'ro_RO' : 'en_GB'} />
<meta property="og:site_name" content="Rotary Club Caransebeș" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
