---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getLangFromUrl, useTranslations, localePath } from '../../i18n/utils';
import { site } from '../../data/site';
import { home } from '../../data/home';
import { donate } from '../../data/donate';
import { ORG_ID, SITE_URL } from '../../lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const rows = [
  { label: t('page.doneaza.beneficiary'), value: site.bank.beneficiary },
  { label: t('page.doneaza.iban'), value: site.bank.iban, copy: true },
  { label: t('page.doneaza.bankName'), value: site.bank.bankName },
  { label: t('page.doneaza.cui'), value: site.bank.cif },
].filter((r) => r.value);

const reasons = home[lang].domains.items;
const copy = donate[lang];
const pageUrl = new URL(localePath(lang, '/doneaza'), SITE_URL).href;
const shareImage = '/images/proiecte/aripi-pentru-viitor-og.jpg';

// Tells search engines this is the club's donation page and how to give.
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: copy.title,
    description: copy.seoDescription,
    inLanguage: lang === 'ro' ? 'ro-RO' : 'en-GB',
    primaryImageOfPage: new URL(shareImage, SITE_URL).href,
    about: { '@id': ORG_ID },
    potentialAction: {
      '@type': 'DonateAction',
      name: copy.title,
      recipient: { '@id': ORG_ID },
      target: pageUrl,
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    inLanguage: lang === 'ro' ? 'ro-RO' : 'en-GB',
    mainEntity: copy.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDescription}
  image={shareImage}
  imageAlt={t('page.doneaza.featuredTitle')}
  jsonLd={jsonLd}
>
  <PageHero eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} />

  <section class="container-page grid gap-8 py-12 sm:py-16 lg:grid-cols-5">
    <div class="card lg:col-span-3">
      <h2 class="text-xl font-extrabold">{t('page.doneaza.bank')}</h2>
      <h3 class="mt-4 text-sm font-bold uppercase tracking-wide text-rotary-azure">{copy.steps.title}</h3>
      <ol class="mt-3 flex flex-col gap-2 text-sm text-rotary-ink/80">
        {
          copy.steps.items.map((step, i) => (
            <li class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rotary-gold text-xs font-bold text-rotary-navy">{i + 1}</span>
              <span class="pt-0.5">{step}</span>
            </li>
          ))
        }
      </ol>
      <dl id="date-bancare" class="mt-4 scroll-mt-24 divide-y divide-black/5">
        {
          rows.map((r) => (
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
              <dt class="text-xs font-bold uppercase tracking-wide text-rotary-ink/50">{r.label}</dt>
              <dd class="flex items-center gap-2 font-semibold text-rotary-blue">
                <span class:list={['[overflow-wrap:anywhere]', { 'font-mono text-sm sm:text-base': r.copy }]}>{r.value}</span>
                {r.copy && (
                  <button
                    type="button"
                    class="copy-btn shrink-0 rounded-full bg-rotary-gold/20 px-3 py-1.5 text-xs font-bold text-rotary-navy transition hover:bg-rotary-gold/40 active:scale-95 active:bg-rotary-gold/60 data-[done]:bg-green-600 data-[done]:text-white"
                    data-copy={r.value.replace(/\s+/g, '')}
                    data-copied={t('page.doneaza.copied')}
                  >
                    {t('page.doneaza.copy')}
                  </button>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 rounded-xl bg-rotary-cream p-4 text-sm text-rotary-ink/80">{t('page.doneaza.mention')}</p>
      <a href="#formular-230" class="mt-4 inline-block text-sm font-semibold text-rotary-azure hover:text-rotary-blue">
        {lang === 'ro' ? 'Sau redirecționează 3,5% din impozit — formularul 230 →' : 'Or redirect 3.5% of your income tax — form 230 →'}
      </a>
    </div>

    <div class="flex flex-col gap-6 lg:col-span-2">
      <a
        href={localePath(lang, '/proiecte/aripi-pentru-viitor')}
        class="group card overflow-hidden p-0 ring-2 ring-rotary-gold/60 transition hover:-translate-y-1 hover:shadow-xl"
      >
        <img src="/images/proiecte/aripi-pentru-viitor.webp" alt={t('page.doneaza.featuredTitle')} loading="lazy" class="aspect-[16/8] w-full object-cover" />
        <div class="p-6">
          <p class="section-eyebrow">{t('page.doneaza.featured')}</p>
          <h2 class="mt-2 text-lg font-extrabold">{t('page.doneaza.featuredTitle')}</h2>
          <p class="mt-2 text-sm text-rotary-ink/75">{t('page.doneaza.featuredText')}</p>
          <span class="mt-3 inline-block text-sm font-semibold text-rotary-azure group-hover:text-rotary-blue">{t('common.readMore')} →</span>
        </div>
      </a>
      <div class="card">
        <h2 class="text-lg font-extrabold">{t('page.doneaza.why')}</h2>
        <ul class="mt-4 flex flex-col gap-3 text-sm">
          {
            reasons.map((reason) => (
              <li class="flex gap-3">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-rotary-gold" />
                <span>
                  <strong class="text-rotary-blue">{reason.title}</strong> — {reason.text}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card bg-rotary-blue text-white">
        <h2 class="text-lg font-extrabold text-white">{t('page.doneaza.foundation')}</h2>
        <p class="mt-2 text-sm text-white/80">{t('page.doneaza.foundationDesc')}</p>
        <a href={localePath(lang, '/fundatia-rotary')} class="btn-primary mt-4">{t('page.doneaza.foundationCta')}</a>
      </div>
    </div>
  </section>

  <section class="border-t border-black/5 py-12 sm:py-16" aria-labelledby="tax-title">
    <div class="container-page">
      <p class="section-eyebrow">{lang === 'ro' ? '3,5% · Formular 230' : '3.5% · Form 230'}</p>
      <h2 id="tax-title" class="mt-2 text-2xl font-extrabold sm:text-3xl">{copy.taxTitle}</h2>
      <p class="mt-3 max-w-2xl text-rotary-ink/75">{copy.taxIntro}</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          copy.tax.map((block) => (
            <div id={block.id} class="card flex scroll-mt-24 flex-col">
              <span class="self-start rounded-full bg-rotary-gold/20 px-3 py-1 text-xs font-bold uppercase tracking-wide text-rotary-navy">{block.badge}</span>
              <h3 class="mt-3 text-lg font-extrabold text-rotary-blue">{block.title}</h3>
              <ul class="mt-4 flex flex-1 flex-col gap-3 text-sm text-rotary-ink/80">
                {block.items.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-rotary-gold" />
                    <span class="[overflow-wrap:anywhere]">{item}</span>
                  </li>
                ))}
              </ul>
              {block.cta && (
                <a href={localePath(lang, '/contact')} class="btn-outline mt-6 self-start">
                  {block.cta}
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-rotary-cream py-12 sm:py-16" aria-labelledby="faq-title">
    <div class="container-page max-w-3xl">
      <h2 id="faq-title" class="text-2xl font-extrabold sm:text-3xl">{copy.faqTitle}</h2>
      <div class="mt-6 flex flex-col gap-3">
        {
          copy.faq.map((item, i) => (
            <details class="group rounded-2xl bg-white shadow-card ring-1 ring-black/5" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl p-5 font-semibold text-rotary-blue transition hover:bg-rotary-gold/10 active:bg-rotary-gold/20 [&::-webkit-details-marker]:hidden">
                <h3 class="text-base">{item.q}</h3>
                <svg class="h-5 w-5 shrink-0 text-rotary-gold transition group-open:rotate-45" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M10 4v12M4 10h12" stroke-linecap="round" />
                </svg>
              </summary>
              <p class="px-5 pb-5 text-sm leading-relaxed text-rotary-ink/80 [overflow-wrap:anywhere]">{item.a}</p>
            </details>
          ))
        }
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#date-bancare" class="btn-primary">{t('nav.doneaza')}</a>
        <a href={localePath(lang, '/contact')} class="btn-outline">{copy.contactCta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Older browsers / non-secure contexts: select the IBAN so it can be copied by hand.
        const value = btn.previousElementSibling;
        if (value) getSelection()?.selectAllChildren(value);
        return;
      }
      btn.textContent = btn.dataset.copied ?? '✓';
      btn.dataset.done = '';
      navigator.vibrate?.(15);
      setTimeout(() => {
        btn.textContent = original;
        delete btn.dataset.done;
      }, 1800);
    });
  });
</script>
