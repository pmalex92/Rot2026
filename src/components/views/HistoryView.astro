---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import RotaryWheel from '../RotaryWheel.astro';
import Icon from '../Icon.astro';
import { getLangFromUrl, localePath } from '../../i18n/utils';
import { eras, figures, future, intro, labels, tagline, type TimelineItem } from '../../data/history';
import { home } from '../../data/home';

const lang = getLangFromUrl(Astro.url);
const l = labels[lang];

const itemHref = (item: TimelineItem) =>
  item.project ? localePath(lang, `/proiecte/${item.project}`) : item.link ? localePath(lang, item.link) : undefined;
---

<BaseLayout title={`${l.title} — Rotary Club Caransebeș`} description={intro[lang][0]} image="/images/rc-caransebes-district-2241-1200.webp">
  <PageHero title={l.title} intro={intro[lang][0]} eyebrow={l.eyebrow} />

  <!-- Intro -->
  <section class="bg-white py-14 sm:py-20">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <picture data-reveal>
        <source srcset="/images/rc-caransebes-district-2241-700.webp 700w, /images/rc-caransebes-district-2241-1200.webp 1200w" sizes="(min-width: 1024px) 50vw, 100vw" />
        <img
          src="/images/rc-caransebes-district-2241-1200.webp"
          alt={lang === 'ro' ? 'Rotary Club Caransebeș, District 2241, fondat 2006: o clădire istorică din Caransebeș și stema municipiului' : "Rotary Club Caransebeș, District 2241, founded 2006: a historic building in Caransebeș and the city's coat of arms"}
          width="1200"
          height="791"
          class="w-full rounded-2xl shadow-card"
        />
      </picture>
      <div data-reveal>
        {intro[lang].slice(1).map((p) => <p class="mb-4 text-lg text-rotary-ink/80">{p}</p>)}
        <div class="mt-6 border-l-4 border-rotary-gold pl-5">
          {tagline[lang].map((line) => <p class="font-display text-xl font-bold text-rotary-blue sm:text-2xl">{line}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Figures -->
  <section class="relative overflow-hidden bg-rotary-blue py-14 text-white sm:py-20">
    <RotaryWheel class="pointer-events-none absolute -top-20 -right-20 h-80 w-80 text-white/5" />
    <div class="container-page relative">
      <h2 class="text-center text-3xl font-extrabold text-white sm:text-4xl" data-reveal>{l.figuresTitle}</h2>
      <dl class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-5">
        {
          figures.map((f, i) => (
            <div class:list={['flex flex-col items-center text-center', { 'col-span-2 sm:col-span-1': i === 0 }]} data-reveal>
              <dt class="order-2 mt-2 max-w-[12rem] text-sm text-white/75">{f.label[lang]}</dt>
              <dd
                class:list={[
                  'order-1 font-display font-extrabold whitespace-nowrap text-rotary-gold',
                  f.value.length > 6 ? 'text-4xl sm:text-3xl xl:text-4xl' : 'text-4xl sm:text-5xl',
                ]}
              >
                {f.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Era navigation -->
  <nav class="sticky top-16 z-30 border-b border-black/5 bg-rotary-cream/95 backdrop-blur xl:top-20" aria-label={l.timelineTitle}>
    <div class="container-page flex gap-2 overflow-x-auto py-3 text-sm font-semibold [scrollbar-width:none]">
      {
        eras.map((era) => (
          <a href={`#${era.id}`} class="shrink-0 rounded-full bg-white px-4 py-1.5 text-rotary-blue ring-1 ring-rotary-blue/15 transition hover:bg-rotary-blue hover:text-white">
            {era.years}
          </a>
        ))
      }
    </div>
  </nav>

  <!-- Timeline -->
  <div class="container-page py-12 sm:py-16">
    {
      eras.map((era) => (
        <section id={era.id} class="scroll-mt-36 pb-14 last:pb-0 sm:pb-20">
          <header class="max-w-3xl" data-reveal>
            <p class="section-eyebrow">{era.years}</p>
            <h2 class="mt-2 text-3xl leading-tight font-extrabold sm:text-4xl">{era.title[lang]}</h2>
            <p class="mt-4 text-lg text-rotary-ink/75">{era.intro[lang]}</p>
          </header>

          <ol class="relative mt-8 border-l-2 border-rotary-gold/40 pl-5 sm:ml-2 sm:pl-8 lg:ml-0 lg:grid lg:grid-cols-2 lg:gap-5 lg:border-l-0 lg:pl-0">
            {era.items.map((item) => {
              const href = itemHref(item);
              return (
                <li class="relative pb-6 last:pb-0 lg:pb-0" data-reveal>
                  <span class="absolute top-6 -left-[27px] h-3.5 w-3.5 rounded-full border-[3px] border-rotary-cream bg-rotary-gold sm:-left-[39px] lg:hidden" />
                  <article class="card flex h-full gap-4 p-4 sm:gap-5 sm:p-5">
                    {item.img && (
                      <img
                        src={`/images/istoric/${item.img}.webp`}
                        alt={item.title[lang]}
                        loading="lazy"
                        class="h-20 w-20 shrink-0 rounded-xl object-cover sm:h-24 sm:w-32"
                      />
                    )}
                    <div class="min-w-0">
                      <span class="inline-block rounded-full bg-rotary-blue px-2.5 py-0.5 text-xs font-bold text-white tabular-nums">{item.year}</span>
                      <h3 class="mt-2 leading-snug font-bold sm:text-lg">{item.title[lang]}</h3>
                      <p class="mt-1 text-sm text-rotary-ink/75">{item.text[lang]}</p>
                      {href && (
                        <a href={href} class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-rotary-azure hover:text-rotary-blue">
                          {l.details}
                          <Icon name="arrowRight" class="h-4 w-4" strokeWidth={2.2} />
                        </a>
                      )}
                    </div>
                  </article>
                </li>
              );
            })}
          </ol>

          {era.outro && <p class="mt-8 max-w-3xl text-rotary-ink/70 italic" data-reveal>{era.outro[lang]}</p>}

          {era.id === 'referinta' && (
            <a
              href={localePath(lang, '/proiecte/global-grant-spitalul-municipal-caransebes')}
              class="group relative mt-10 block overflow-hidden rounded-2xl bg-rotary-navy p-6 text-white shadow-card sm:p-10"
              data-reveal
            >
              <RotaryWheel class="pointer-events-none absolute -right-12 -bottom-12 h-56 w-56 text-rotary-gold/15 transition duration-700 group-hover:rotate-45" />
              <p class="section-eyebrow relative">{l.emblemEyebrow}</p>
              <h3 class="relative mt-2 max-w-2xl text-2xl font-extrabold text-white sm:text-3xl">{l.emblemTitle}</h3>
              <p class="relative mt-4 max-w-2xl text-white/80">{l.emblemText}</p>
              <span class="relative mt-6 inline-flex items-center gap-2 font-semibold text-rotary-gold">
                {l.details}
                <Icon name="arrowRight" class="h-4 w-4 transition group-hover:translate-x-1" strokeWidth={2.2} />
              </span>
            </a>
          )}
        </section>
      ))
    }
  </div>

  <!-- What comes next -->
  <section class="py-14 sm:py-20">
    <div class="container-page max-w-4xl" data-reveal>
      <h2 class="text-3xl leading-tight font-extrabold sm:text-4xl">{future[lang].title}</h2>
      {future[lang].paragraphs.map((p) => <p class="mt-4 text-lg text-rotary-ink/80">{p}</p>)}
      <blockquote class="mt-8 border-l-4 border-rotary-gold bg-white p-6 font-display text-xl font-bold text-rotary-blue shadow-card sm:text-2xl">
        {future[lang].quote}
      </blockquote>
    </div>
  </section>

  <!-- Thanks -->
  <section class="relative overflow-hidden bg-rotary-navy py-14 text-white sm:py-20">
    <RotaryWheel class="pointer-events-none absolute top-1/2 -right-24 h-[26rem] w-[26rem] -translate-y-1/2 text-rotary-gold/10" />
    <div class="container-page relative max-w-3xl" data-reveal>
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl">{l.thanksTitle}</h2>
      <p class="mt-4 text-lg text-white/80">{l.thanksText}</p>
      <div class="mt-6">
        {tagline[lang].map((line) => <p class="font-display text-lg font-bold text-rotary-gold sm:text-xl">{line}</p>)}
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={localePath(lang, '/doneaza')} class="btn-primary">{home[lang].join.ctaSupport}</a>
        <a href={localePath(lang, '/membership/admitere-in-club')} class="btn-secondary">{home[lang].join.ctaJoin}</a>
      </div>
    </div>
  </section>
</BaseLayout>
