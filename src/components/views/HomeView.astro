---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoHero from '../VideoHero.astro';
import NewsCard from '../NewsCard.astro';
import ProjectCard from '../ProjectCard.astro';
import RotaryWheel from '../RotaryWheel.astro';
import Icon from '../Icon.astro';
import { getLangFromUrl, useTranslations, localePath } from '../../i18n/utils';
import { getFacebookPosts } from '../../lib/facebook';
import { getProjects } from '../../lib/projects';
import { site, mapUrl } from '../../data/site';
import { home } from '../../data/home';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = home[lang];
const numberLocale = lang === 'ro' ? 'ro-RO' : 'en-GB';

const posts = getFacebookPosts(3);
const projects = (await getProjects(lang)).slice(0, 6);

const stats = [
  { value: site.stats.years, label: c.impact.labels.years },
  { value: site.stats.projects, label: c.impact.labels.projects },
  { value: site.stats.beneficiaries, label: c.impact.labels.beneficiaries },
  { value: site.stats.partners, label: c.impact.labels.partners },
];
const [emailUser, emailDomain] = site.email.split('@');
const supportHref = localePath(lang, '/doneaza');
const joinHref = localePath(lang, '/membership/admitere-in-club');
---

<BaseLayout title={`Rotary Club Caransebeș — ${c.hero.title} ${c.hero.since}`} description={c.hero.text}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
    <link rel="preconnect" href="https://f.vimeocdn.com" />
  </Fragment>
  <!-- Hero -->
  <VideoHero vimeoId={site.heroVimeoId} title="Rotary Club Caransebeș">
    <div class="container-page flex flex-col justify-end gap-6 pt-24 pb-14 sm:justify-center sm:py-24">
      <p class="section-eyebrow text-sm">{c.hero.eyebrow}</p>
      <h1 class="max-w-3xl text-4xl leading-[1.05] font-extrabold text-white sm:text-6xl lg:text-7xl">
        {c.hero.title}
        <span class="mt-2 block text-rotary-gold">{c.hero.since}</span>
      </h1>
      <p class="max-w-xl text-base text-white/90 sm:text-xl">{c.hero.text}</p>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <a href={supportHref} class="btn-primary">{c.hero.ctaSupport}</a>
        <a href={joinHref} class="btn-secondary">{c.hero.ctaJoin}</a>
      </div>
      <a
        href="#cine-suntem"
        class="mt-6 hidden items-center gap-2 self-start text-xs font-semibold tracking-widest text-white/70 uppercase hover:text-white sm:inline-flex"
      >
        <Icon name="chevronDown" class="h-4 w-4 motion-safe:animate-bounce" strokeWidth={2.2} />
        {c.hero.scroll}
      </a>
    </div>
  </VideoHero>

  <!-- Cine suntem -->
  <section id="cine-suntem" class="relative scroll-mt-20 overflow-hidden bg-white py-16 sm:py-24">
    <span
      class="pointer-events-none absolute -bottom-8 -left-4 font-display text-[9rem] leading-none font-extrabold text-rotary-blue/[0.04] select-none sm:text-[16rem]"
      aria-hidden="true">{site.founded}</span
    >
    <div class="container-page relative grid gap-8 lg:grid-cols-2 lg:gap-16" data-reveal>
      <div>
        <p class="section-eyebrow">{c.about.eyebrow}</p>
        <h2 class="mt-3 text-3xl leading-tight font-extrabold sm:text-4xl">{c.about.title}</h2>
        <span class="mt-6 block h-1 w-16 rounded-full bg-rotary-gold"></span>
      </div>
      <div class="flex flex-col gap-4 text-lg text-rotary-ink/80">
        {c.about.paragraphs.map((p) => <p>{p}</p>)}
        <a href={localePath(lang, '/despre-noi')} class="btn-outline mt-2 self-start">
          {c.about.cta}
          <Icon name="arrowRight" class="h-4 w-4" strokeWidth={2.2} />
        </a>
      </div>
    </div>
  </section>

  <!-- Ce facem -->
  <section class="py-16 sm:py-24">
    <div class="container-page">
      <div class="max-w-2xl" data-reveal>
        <p class="section-eyebrow">{c.domains.eyebrow}</p>
        <h2 class="mt-3 text-3xl leading-tight font-extrabold sm:text-4xl">{c.domains.title}</h2>
        <p class="mt-4 text-lg text-rotary-ink/70">{c.domains.intro}</p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          c.domains.items.map((item, i) => (
            <li
              class="card group flex gap-4 p-5 transition hover:-translate-y-1 hover:shadow-xl lg:flex-col lg:p-6"
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-rotary-gold/15 text-rotary-blue transition group-hover:bg-rotary-gold group-hover:text-rotary-navy">
                <Icon name={item.icon} />
              </span>
              <div>
                <h3 class="text-lg font-bold">{item.title}</h3>
                <p class="mt-1 text-sm text-rotary-ink/70">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Impact -->
  <section class="relative overflow-hidden bg-rotary-blue py-16 text-white sm:py-24">
    <RotaryWheel class="pointer-events-none absolute -top-20 -right-20 h-80 w-80 text-white/5" />
    <div class="container-page relative">
      <div class="text-center" data-reveal>
        <p class="section-eyebrow">{c.impact.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">{c.impact.title}</h2>
      </div>
      <dl class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4">
        {
          stats.map((s) => (
            <div class="flex flex-col items-center text-center" data-reveal>
              <dt class="order-2 mt-2 max-w-[12rem] text-sm text-white/75 sm:text-base">{s.label}</dt>
              <dd class="order-1 font-display text-4xl font-extrabold text-rotary-gold tabular-nums sm:text-6xl">
                <span data-count-to={s.value} data-locale={numberLocale}>
                  {s.value.toLocaleString(numberLocale)}
                </span>
                +
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Misiunea -->
  <section class="bg-white py-16 sm:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-2" data-reveal>
        <p class="section-eyebrow">{c.mission.eyebrow}</p>
        <h2 class="mt-3 text-3xl leading-tight font-extrabold sm:text-4xl">{c.mission.title}</h2>
        {c.mission.paragraphs.map((p, i) => <p class:list={['mt-4 text-lg', i === 0 ? 'text-rotary-ink/80' : 'font-semibold text-rotary-blue']}>{p}</p>)}
      </div>
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:col-span-3">
        {
          c.mission.values.map((v, i) => (
            <li class="flex gap-4" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-rotary-blue text-white">
                <Icon name={v.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-bold">{v.title}</h3>
                <p class="mt-1 text-sm text-rotary-ink/70">{v.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Proiecte -->
  {
    projects.length > 0 && (
      <section class="py-16 sm:py-24">
        <div class="container-page">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
            <div class="max-w-3xl">
              <p class="section-eyebrow">{c.projects.eyebrow}</p>
              <h2 class="mt-3 text-3xl leading-tight font-extrabold sm:text-4xl">{c.projects.title}</h2>
              <p class="mt-4 text-rotary-ink/70 sm:text-lg">{c.projects.intro}</p>
            </div>
            <a href={localePath(lang, '/proiecte')} class="btn-outline shrink-0 self-start lg:self-end">
              {c.projects.all}
            </a>
          </div>
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <div data-reveal>
                <ProjectCard project={project} readMore={c.projects.readMore} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Știri Facebook -->
  <section class="bg-white py-16 sm:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
        <div>
          <p class="section-eyebrow">{t('home.news.subtitle')}</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">{t('home.news.title')}</h2>
        </div>
        <a href={localePath(lang, '/stiri')} class="btn-outline shrink-0 self-start">{t('home.news.viewAll')}</a>
      </div>
      {
        posts.length > 0 ? (
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => <NewsCard post={post} />)}
          </div>
        ) : (
          <p class="mt-8 max-w-xl text-rotary-ink/60">{t('home.news.empty')}</p>
        )
      }
    </div>
  </section>

  <!-- Implică-te -->
  <section class="relative overflow-hidden bg-rotary-navy py-16 text-white sm:py-24">
    <RotaryWheel class="pointer-events-none absolute top-1/2 -right-24 h-[26rem] w-[26rem] -translate-y-1/2 text-rotary-gold/10" />
    <div class="container-page relative grid gap-10 lg:grid-cols-2 lg:items-center">
      <div data-reveal>
        <p class="section-eyebrow">{c.join.eyebrow}</p>
        <h2 class="mt-3 text-3xl leading-tight font-extrabold text-white sm:text-4xl">{c.join.title}</h2>
        <p class="mt-4 max-w-xl text-lg text-white/80">{c.join.text}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={supportHref} class="btn-primary">{c.join.ctaSupport}</a>
          <a href={joinHref} class="btn-secondary">{c.join.ctaJoin}</a>
        </div>
      </div>

      <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur-sm sm:p-8" data-reveal>
        <h3 class="text-sm font-bold tracking-widest text-rotary-gold uppercase">{c.join.meetings}</h3>
        <ul class="mt-5 flex flex-col gap-4 text-white/90">
          <li class="flex gap-3">
            <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-rotary-gold" />
            <span class="font-semibold">{site.meeting[lang].when}</span>
          </li>
          <li class="flex gap-3">
            <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-rotary-gold" />
            <span>
              {site.meeting[lang].where}
              <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="mt-1 block text-sm font-semibold text-rotary-gold hover:text-rotary-gold2">
                {c.join.map} →
              </a>
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0 text-rotary-gold" />
            <a href={`mailto:${site.email}`} class="[overflow-wrap:anywhere] hover:text-white">
              {emailUser}@<wbr />{emailDomain}
            </a>
          </li>
        </ul>
        <div class="mt-6 flex gap-3 border-t border-white/10 pt-6">
          <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Facebook">
            <Icon name="facebook" class="h-5 w-5" />
          </a>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
            <Icon name="instagram" class="h-5 w-5" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.countTo);
      const locale = el.dataset.locale;
      const duration = 1600;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(target * eased).toLocaleString(locale);
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          animate(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.6 }
    );
    counters.forEach((el) => {
      el.textContent = '0';
      observer.observe(el);
    });
  }
</script>
