---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  type: 'activ' | 'fost-presedinte';
}
const { type } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const members = (await getCollection('members', (e) => e.data.lang === lang && e.data.type === type)).sort(
  (a, b) =>
    type === 'fost-presedinte'
      ? (b.data.years ?? '').localeCompare(a.data.years ?? '')
      : a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)
);

const title = t(type === 'activ' ? 'nav.despre.membri' : 'nav.despre.fostiPresedinti');
const intro = t(type === 'activ' ? 'page.membri.intro' : 'page.fostiPresedinti.intro');

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((n) => n[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<BaseLayout title={`${title} — Rotary Club Caransebeș`} description={intro}>
  <PageHero title={title} intro={intro} eyebrow={t('nav.despre')} />

  <section class="container-page py-12 sm:py-16">
    {members.length === 0 && <p class="text-rotary-ink/60">{t('page.empty')}</p>}

    {
      type === 'activ' ? (
        <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {members.map((m) => (
            <li class="card flex flex-col items-center gap-3 p-5 text-center">
              {m.data.photo ? (
                <img src={m.data.photo} alt={m.data.name} loading="lazy" class="h-24 w-24 rounded-full object-cover ring-4 ring-rotary-gold/30" />
              ) : (
                <span class="flex h-24 w-24 items-center justify-center rounded-full bg-rotary-blue font-display text-2xl font-bold text-white ring-4 ring-rotary-gold/30">
                  {initials(m.data.name)}
                </span>
              )}
              <div>
                <p class="font-display font-bold text-rotary-blue">{m.data.name}</p>
                {m.data.role && <p class="mt-1 text-xs text-rotary-ink/60">{m.data.role}</p>}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <ol class="relative mx-auto max-w-2xl border-l-2 border-rotary-gold/40 pl-6">
          {members.map((m) => (
            <li class="relative pb-8 last:pb-0">
              <span class="absolute -left-[33px] top-1 h-4 w-4 rounded-full border-4 border-rotary-cream bg-rotary-gold" />
              <p class="section-eyebrow">{m.data.years}</p>
              <p class="mt-1 font-display text-lg font-bold text-rotary-blue">{m.data.name}</p>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</BaseLayout>
