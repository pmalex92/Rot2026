---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { activeMembers, pastPresidents } from '../../data/members';

interface Props {
  type: 'activ' | 'fost-presedinte';
}
const { type } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t(type === 'activ' ? 'nav.despre.membri' : 'nav.despre.fostiPresedinti');
const intro = t(type === 'activ' ? 'page.membri.intro' : 'page.fostiPresedinti.intro');

const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .map((n) => n[0])
    .slice(0, 2)
    .join('')
    .toLocaleUpperCase('ro-RO');
---

<BaseLayout title={`${title} — Rotary Club Caransebeș`} description={intro}>
  <PageHero title={title} intro={intro} eyebrow={t('nav.despre')} />

  <section class="container-page py-12 sm:py-16">
    {
      type === 'activ' ? (
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
          {activeMembers.map((name) => (
            <li class="card flex flex-col items-center gap-3 p-4 text-center sm:p-5" data-reveal>
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-rotary-blue font-display text-xl font-bold text-white ring-4 ring-rotary-gold/30 sm:h-20 sm:w-20 sm:text-2xl">
                {initials(name)}
              </span>
              <p class="font-display leading-snug font-bold text-rotary-blue">{name}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="mx-auto max-w-2xl">
          <div class="mb-6 hidden justify-between border-b border-black/10 pb-3 pl-8 text-xs sm:flex font-bold tracking-widest text-rotary-ink/50 uppercase">
            <span>{t('page.fostiPresedinti.year')}</span>
            <span>{t('page.fostiPresedinti.president')}</span>
          </div>
          <ol class="relative border-l-2 border-rotary-gold/40 pl-6">
            {pastPresidents.map((p) => (
              <li class="relative flex flex-col gap-1 pb-7 last:pb-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <span class="absolute top-1 -left-[33px] h-4 w-4 rounded-full border-4 border-rotary-cream bg-rotary-gold" />
                <span class="section-eyebrow shrink-0 tabular-nums">{p.year}</span>
                <span class="font-display text-lg font-bold text-rotary-blue sm:text-right">{p.name}</span>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </section>
</BaseLayout>
