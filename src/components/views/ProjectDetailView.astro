---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import RotaryWheel from '../RotaryWheel.astro';
import { getLangFromUrl, useTranslations, localePath } from '../../i18n/utils';
import { projectWhen, type Project } from '../../lib/projects';
import { ORG_ID, SITE_URL } from '../../lib/seo';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(project);
const { title, image, thumb, excerpt, category, cta, shareImage, date } = project.data;
const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;
const articleLd = {
  '@type': 'Article',
  headline: title,
  description: excerpt ?? title,
  inLanguage: lang === 'ro' ? 'ro-RO' : 'en-GB',
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  image: new URL(shareImage ?? image ?? thumb ?? '/images/og-cover.jpg', SITE_URL).href,
  author: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
  ...(date ? { datePublished: date.toISOString().slice(0, 10) } : {}),
  about: t(category === 'realizare' ? 'nav.proiecte.realizari' : 'nav.proiecte.actiuni'),
};
const when = projectWhen(project, lang);
const categoryPath = category === 'realizare' ? '/proiecte/realizari' : '/proiecte/actiuni';
const categoryLabel = t(category === 'realizare' ? 'nav.proiecte.realizari' : 'nav.proiecte.actiuni');
---

<BaseLayout
  title={`${title} — Rotary Club Caransebeș`}
  description={excerpt ?? title}
  image={shareImage ?? image}
  imageAlt={title}
  type="article"
  jsonLd={[articleLd]}
>
  <PageHero title={title} intro={excerpt} eyebrow={when ? `${categoryLabel} · ${when}` : categoryLabel} />

  <article class="container-page max-w-3xl py-10 sm:py-14">
    {image && <img src={image} alt={title} fetchpriority="high" class="mb-8 w-full rounded-2xl object-cover shadow-card" />}
    {!image && thumb && <img src={thumb} alt={title} class="mb-6 h-40 w-56 rounded-2xl object-cover shadow-card sm:float-right sm:mb-4 sm:ml-8" />}
    <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-rotary-blue prose-a:font-semibold prose-a:text-rotary-azure prose-blockquote:border-rotary-gold prose-blockquote:bg-white prose-blockquote:py-1 prose-blockquote:not-italic prose-img:rounded-xl">
      <Content />
    </div>
    {
      cta === 'donate' && (
        <aside class="relative mt-12 overflow-hidden rounded-2xl bg-rotary-navy p-6 text-white shadow-card sm:p-10">
          <RotaryWheel class="pointer-events-none absolute -right-12 -bottom-12 h-56 w-56 text-rotary-gold/15" />
          <h2 class="relative text-2xl font-extrabold text-white sm:text-3xl">{t('project.cta.title')}</h2>
          <p class="relative mt-3 max-w-xl text-white/80">{t('project.cta.text')}</p>
          <div class="relative mt-6 flex flex-col gap-3 sm:flex-row">
            <a href={localePath(lang, '/doneaza')} class="btn-primary">{t('nav.doneaza')}</a>
            <a href={localePath(lang, '/contact')} class="btn-secondary">{t('project.cta.contact')}</a>
          </div>
        </aside>
      )
    }
    <a href={localePath(lang, categoryPath)} class="btn-outline mt-10">
      <Icon name="arrowRight" class="h-4 w-4 rotate-180" strokeWidth={2.2} />
      {categoryLabel}
    </a>
  </article>
</BaseLayout>
