---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ProjectCard from '../ProjectCard.astro';
import { getLangFromUrl, useTranslations, localePath } from '../../i18n/utils';
import { getProjects } from '../../lib/projects';
import { home } from '../../data/home';

interface Props {
  category?: 'realizare' | 'actiune';
}
const { category } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang, category);

const title = category
  ? t(category === 'realizare' ? 'nav.proiecte.realizari' : 'nav.proiecte.actiuni')
  : t('nav.proiecte');
const intro = category
  ? t(category === 'realizare' ? 'page.realizari.intro' : 'page.actiuni.intro')
  : t('page.proiecte.intro');

const tabs = [
  { href: '/proiecte', label: t('nav.proiecte'), active: !category },
  { href: '/proiecte/realizari', label: t('nav.proiecte.realizari'), active: category === 'realizare' },
  { href: '/proiecte/actiuni', label: t('nav.proiecte.actiuni'), active: category === 'actiune' },
];
---

<BaseLayout title={`${title} — Rotary Club Caransebeș`} description={intro}>
  <PageHero title={title} intro={intro} eyebrow={category ? t('nav.proiecte') : undefined} />

  <div class="container-page py-8">
    <nav class="flex gap-2 overflow-x-auto pb-1 text-sm font-semibold" aria-label={t('nav.proiecte')}>
      {
        tabs.map((tab) => (
          <a
            href={localePath(lang, tab.href)}
            class:list={[
              'shrink-0 rounded-full px-4 py-2 transition',
              tab.active ? 'bg-rotary-blue text-white' : 'bg-white text-rotary-blue ring-1 ring-rotary-blue/20 hover:bg-rotary-blue/5',
            ]}
            aria-current={tab.active ? 'page' : undefined}
          >
            {tab.label}
          </a>
        ))
      }
    </nav>
  </div>

  <section class="container-page pb-16 sm:pb-20">
    {
      projects.length === 0 ? (
        <p class="text-rotary-ink/60">{t('page.empty')}</p>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <ProjectCard project={p} readMore={home[lang].projects.readMore} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
