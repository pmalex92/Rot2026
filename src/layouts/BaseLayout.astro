---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { getLangFromUrl, switchLocalePath } from '../i18n/utils';
import type { JsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: JsonLd[];
}
const { title, description, image, imageAlt, type, noindex, jsonLd } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const alternates = (['ro', 'en'] as const).map((l) => ({ lang: l, href: new URL(switchLocalePath(Astro.url, l), Astro.site) }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B2F63" />
    <SEO title={title} description={description} image={image} imageAlt={imageAlt} type={type} noindex={noindex} jsonLd={jsonLd} />
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-rotary-blue"
    >
      {lang === 'ro' ? 'Sări la conținut' : 'Skip to content'}
    </a>
    <div id="nav-progress" aria-hidden="true"></div>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Visible feedback while the next page loads: top progress bar + the tapped link stays "pressed".
      const progress = document.getElementById('nav-progress');
      const resetNavigation = () => {
        progress?.classList.remove('is-active');
        document.querySelectorAll('.is-navigating').forEach((el) => el.classList.remove('is-navigating'));
        const menuToggle = document.getElementById('mobile-nav-toggle') as HTMLInputElement | null;
        if (menuToggle) menuToggle.checked = false;
      };
      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
        if (!link || (link.target && link.target !== '_self') || link.hasAttribute('download')) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname && url.search === location.search) return;
        progress?.classList.remove('is-active');
        void progress?.offsetWidth;
        progress?.classList.add('is-active');
        link.classList.add('is-navigating');
      });
      // Coming back via the back button restores the old page from cache: clear the loading state.
      window.addEventListener('pageshow', resetNavigation);
      // iOS Safari only applies :active styles when the page listens for touches.
      document.addEventListener('touchstart', () => {}, { passive: true });

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
